{
    "name": "Seestar50",
    "thresh": 0.5,
    "detection_opening": 5,
    "fwhm_cutout_half": 25,
    "contamination_tolerance": 0.01,
    "moffat_beta": 3.0,
    "header_frame": "fk5",
    "header_equinox": "date",
    "cone_radius_margin": 0.4,
    "wcs_scale_tolerance": 0.005,
    "wcs_pointing_tolerance": 0.30,
    "header_match": [{"keyword": "INSTRUME", "pattern": "Seestar S50"}],
    "header_map": {
        "_note": "Header map for the Seestar50, raw and stacked frames.",
        "_airmass": "used verbatim when present; otherwise derived from ra/dec/site/obs_time",
        "airmass": "@AIRMASS",
        "obs_time": "@DATE-OBS",
        "site_lat": "@SITELAT",
        "site_lon": "@SITELONG",
        "site_elev": "@SITEELEV",
        "observer": "@obscode",
        "_filter": "not for unprocessed files",
        "block_filter": "@FILTER",
        "exposure": "@EXPTIME",
        "tel_manufac": "!CREATOR index 0",
        "tel_model": "@INSTRUME",
        "tel_firmware": "@PROGRAM",
        "adc_depth": 12,
        "largest_usable_adu_value": 50000,
        "_egain": "e-/ADU in 16-bit file units, one per Bayer channel, from photon-transfer curves of flat pairs (no sigma clipping). Two light sources were used: tungsten-halogen gave TR 0.046, TG 0.074, TB 0.076; an electroluminescent panel gave TR 0.046, TG 0.078, TB 0.079. The values here are the means. L4 gets the median per-star effective gain, about 0.065 on sky frames.",
        "egain": {"TR": 0.046, "TG": 0.076, "TB": 0.078},
        "bayerpat": "@BAYERPAT",
        "pixscale": 2.376,
        "refframe": "ICRS",
        "dec": "@DEC",
        "ra": "@RA",
        "fov_rad": 0.74,
        "_telescope_probe": "from fits",
        "roworder": "top-down",
        "xbayroff": 0,
        "ybayroff": 0,
        "stack": "@STACKCNT",
        "#stack": 1,
        "object": "@OBJECT",
        "system_id": "@TELESCOP"
    }
}
